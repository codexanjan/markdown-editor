{
  "name": "markdown-editor",
  "version": "1.0.0",
  "private": false,
  "description": "Markdown Studio - A sleek, browser-based Markdown editor with real-time live preview, GitHub Flavored Markdown (GFM) support, syntax highlighting, templates, version history, and multiple export formats (MD, HTML, PDF, TXT).",
  "homepage": "https://markdown-editor-ten-eta.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexanjan/markdown-editor.git"
  },
  "bugs": {
    "url": "https://github.com/codexanjan/markdown-editor/issues"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "codemirror",
    "react",
    "tailwindcss",
    "vite",
    "typescript",
    "live-preview",
    "gfm",
    "react-markdown",
    "syntax-highlighting"
  ],
  "author": "Anjan Shetty (https://github.com/codexanjan)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
